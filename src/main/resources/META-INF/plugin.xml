<idea-plugin version="2">
	<id>com.gigaide.angular.ts</id>
	<name>Angular JS</name>
	<version>0.1</version>
	<vendor email="gigaide@sberbank.ru" url="https://gigaide.ru">GIGAIDE</vendor>

	<description><![CDATA[
  <p>Angular navigation and metadata support for TypeScript projects using GigaIDE JS/TS PSI.</p>
  ]]></description>

	<change-notes><![CDATA[
        ]]>
	</change-notes>

	<idea-version since-build="251"/>

	<depends>com.intellij.modules.lang</depends>
	<depends>com.gigaide.javascript</depends>
	<depends>com.gigaide.pro</depends>

	<application-components>
	</application-components>

	<project-components>
		<component>
			<implementation-class>com.gigaide.angular.SamplePluginController</implementation-class>
		</component>
	</project-components>

	<actions>
	</actions>

	<extensions defaultExtensionNs="com.intellij">
		<annotator language="TypeScript" implementationClass="com.gigaide.angular.TypeScriptDecoratorAnnotator"/>
		<annotator language="TypeScript" implementationClass="com.gigaide.angular.AngularTemplateAnnotator"/>

		<psi.referenceContributor language="TypeScript"
								  implementation="com.gigaide.angular.AngularComponentResourceReferenceContributor"/>

		<psi.referenceContributor language="HTML"
								 implementation="com.gigaide.angular.AngularHtmlTagReferenceContributor"/>
		<psi.referenceContributor language="XML"
								  implementation="com.gigaide.angular.AngularHtmlTagReferenceContributor"/>
		<completion.contributor language="HTML"
								implementationClass="com.gigaide.angular.AngularHtmlTagCompletionContributor"/>
		<completion.contributor language="XML"
								implementationClass="com.gigaide.angular.AngularHtmlTagCompletionContributor"/>
		<fileBasedIndex implementation="com.gigaide.angular.index.AngularComponentSelectorFileIndex"/>
		<fileBasedIndex implementation="com.gigaide.angular.index.AngularComponentResourceFileIndex"/>
		<gotoDeclarationHandler implementation="com.gigaide.angular.AngularHtmlGotoDeclarationHandler"/>
		<gotoDeclarationHandler implementation="com.gigaide.angular.AngularResourceGotoDeclarationHandler"/>
	</extensions>
</idea-plugin>
